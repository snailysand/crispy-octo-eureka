{
  "manifest_version": 3,
  "name": "X to Xitter Redirect",
  "version": "1.0.0",
  "description": "Opens every x.com (and twitter.com) link on xitter.cf instead.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "redirect_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
